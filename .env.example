# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=wsiannotate.com,www.wsiannotate.com,localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=https://wsiannotate.com,https://www.wsiannotate.com
DJANGO_USE_X_FORWARDED_HOST=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Database (Supabase Postgres, Tokyo). Use the SESSION pooler (port 5432),
# NOT the transaction pooler (6543). URL-encode special chars in the password
# (e.g. $ -> %24). Leave unset locally to fall back to db.sqlite3.
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Media served from CloudFront in production. Point DJANGO_MEDIA_URL at the
# CloudFront domain and keep SERVE_MEDIA_FILES=False (the app does not serve
# image bytes in production; CloudFront does).
DJANGO_MEDIA_URL=https://<cloudfront-domain>/media/
DJANGO_SERVE_MEDIA_FILES=False

# Local development alternative:
# DJANGO_MEDIA_URL=/media/
# DJANGO_MEDIA_ROOT=/absolute/path/to/wsiannotate/media
# DJANGO_SERVE_MEDIA_FILES=True
